{
  "openapi": "3.0.0",
  "info": {
    "title": "Payment API",
    "description": "API de processamento de pagamentos",
    "version": "1.0.0",
    "contact": {
      "name": "API Support",
      "email": "support@example.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8003",
      "description": "Servidor de desenvolvimento - Payment"
    },
    {
      "url": "http://api-gateway:8000/payment",
      "description": "API Gateway - Payment"
    }
  ],
  "paths": {
    "/process": {
      "post": {
        "summary": "Processa um pagamento",
        "description": "Processa um pagamento usando os dados do cartão fornecidos. Requer autenticação JWT",
        "operationId": "processPayment",
        "tags": [
          "Payment"
        ],
        "requestBody": {
          "required": true,
          "description": "Dados do pagamento a ser processado",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentInput"
              },
              "example": {
                "amount": 199.99,
                "card_token": "tok_abcdef123456"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pagamento processado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResult"
                },
                "example": {
                  "status": "processed",
                  "transaction_id": "txn_656e5f3f0d8a9",
                  "amount": 199.99
                }
              }
            }
          },
          "400": {
            "description": "Dados de pagamento inválidos"
          },
          "401": {
            "description": "Não autenticado"
          },
          "402": {
            "description": "Pagamento recusado"
          },
          "500": {
            "description": "Erro interno do servidor"
          }
        },
        "security": [
          {
            "jwt": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "PaymentInput": {
        "type": "object",
        "description": "Dados de entrada para processar um pagamento",
        "required": [
          "amount",
          "card_token"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "format": "float",
            "description": "Valor do pagamento em reais",
            "example": 199.99
          },
          "card_token": {
            "type": "string",
            "description": "Token do cartão de crédito (tokenizado para segurança)",
            "example": "tok_abcdef123456"
          }
        }
      },
      "PaymentResult": {
        "type": "object",
        "description": "Resultado do processamento de pagamento",
        "required": [
          "status",
          "transaction_id",
          "amount"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Status do pagamento",
            "enum": [
              "processed",
              "pending",
              "failed",
              "declined"
            ],
            "example": "processed"
          },
          "transaction_id": {
            "type": "string",
            "description": "ID único da transação",
            "example": "txn_656e5f3f0d8a9"
          },
          "amount": {
            "type": "number",
            "format": "float",
            "description": "Valor processado",
            "example": 199.99
          }
        }
      },
      "Error": {
        "type": "object",
        "description": "Resposta de erro padrão",
        "properties": {
          "code": {
            "type": "integer",
            "description": "Código de erro HTTP"
          },
          "message": {
            "type": "string",
            "description": "Mensagem de erro"
          }
        }
      }
    },
    "securitySchemes": {
      "jwt": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT para autenticação"
      }
    }
  },
  "tags": [
    {
      "name": "Payment",
      "description": "Operações relacionadas a processamento de pagamentos"
    }
  ]
}
