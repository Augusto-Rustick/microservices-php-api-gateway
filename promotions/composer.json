{
    "name": "microservices/catalog",
    "description": "Microserviço de Catálogo de Produtos",
    "type": "project",
    "require": {
        "php": "^8.2",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "php-amqplib/php-amqplib": "^3.6",
        "zircote/swagger-php": "^4.8",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S 0.0.0.0:80 -t public",
        "test": "phpunit"
    }
}
