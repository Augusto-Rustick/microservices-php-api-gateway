{
  "openapi": "3.0.0",
  "info": {
    "title": "Microservices API Gateway",
    "description": "API Gateway centralizado que roteia requisições para múltiplos microserviços (Catalog, Orders, Payment, Promotions)",
    "version": "1.0.0",
    "contact": {
      "name": "API Support",
      "email": "support@example.com"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Servidor de desenvolvimento - API Gateway"
    },
    {
      "url": "http://api-gateway:8000",
      "description": "Servidor de produção - API Gateway"
    }
  ],
  "paths": {
    "/catalog/products": {
      "get": {
        "summary": "Lista todos os produtos",
        "description": "Retorna uma lista completa de todos os produtos disponíveis no catálogo",
        "operationId": "getProducts",
        "tags": [
          "Catalog"
        ],
        "responses": {
          "200": {
            "description": "Lista de produtos retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor"
          }
        }
      },
      "post": {
        "summary": "Cria um novo produto",
        "description": "Cria um novo produto no catálogo. Requer autenticação JWT",
        "operationId": "createProduct",
        "tags": [
          "Catalog"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Produto criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos fornecidos"
          },
          "401": {
            "description": "Não autenticado"
          },
          "500": {
            "description": "Erro interno do servidor"
          }
        },
        "security": [
          {
            "jwt": []
          }
        ]
      }
    },
    "/catalog/products/{id}": {
      "get": {
        "summary": "Busca um produto pelo ID",
        "description": "Retorna os detalhes de um produto específico baseado no ID fornecido",
        "operationId": "getProductById",
        "tags": [
          "Catalog"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID único do produto",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalhes do produto retornados com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "404": {
            "description": "Produto não encontrado"
          },
          "500": {
            "description": "Erro interno do servidor"
          }
        }
      },
      "put": {
        "summary": "Atualiza um produto existente",
        "description": "Atualiza os dados de um produto específico. Requer autenticação JWT",
        "operationId": "updateProduct",
        "tags": [
          "Catalog"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID único do produto",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Produto atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos fornecidos"
          },
          "401": {
            "description": "Não autenticado"
          },
          "404": {
            "description": "Produto não encontrado"
          },
          "500": {
            "description": "Erro interno do servidor"
          }
        },
        "security": [
          {
            "jwt": []
          }
        ]
      },
      "delete": {
        "summary": "Deleta um produto",
        "description": "Remove um produto do catálogo. Requer autenticação JWT",
        "operationId": "deleteProduct",
        "tags": [
          "Catalog"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID único do produto",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Produto deletado com sucesso"
          },
          "401": {
            "description": "Não autenticado"
          },
          "404": {
            "description": "Produto não encontrado"
          },
          "500": {
            "description": "Erro interno do servidor"
          }
        },
        "security": [
          {
            "jwt": []
          }
        ]
      }
    },
    "/orders/orders": {
      "get": {
        "summary": "Lista todos os pedidos",
        "description": "Retorna uma lista de todos os pedidos. Requer autenticação JWT",
        "operationId": "getOrders",
        "tags": [
          "Orders"
        ],
        "responses": {
          "200": {
            "description": "Lista de pedidos retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado"
          },
          "500": {
            "description": "Erro interno do servidor"
          }
        },
        "security": [
          {
            "jwt": []
          }
        ]
      },
      "post": {
        "summary": "Cria um novo pedido",
        "description": "Cria um novo pedido no sistema. Requer autenticação JWT",
        "operationId": "createOrder",
        "tags": [
          "Orders"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pedido criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos fornecidos"
          },
          "401": {
            "description": "Não autenticado"
          },
          "500": {
            "description": "Erro interno do servidor"
          }
        },
        "security": [
          {
            "jwt": []
          }
        ]
      }
    },
    "/payment/process": {
      "post": {
        "summary": "Processa um pagamento",
        "description": "Processa um pagamento usando os dados do cartão fornecidos. Requer autenticação JWT",
        "operationId": "processPayment",
        "tags": [
          "Payment"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pagamento processado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResult"
                }
              }
            }
          },
          "400": {
            "description": "Dados de pagamento inválidos"
          },
          "401": {
            "description": "Não autenticado"
          },
          "402": {
            "description": "Pagamento recusado"
          },
          "500": {
            "description": "Erro interno do servidor"
          }
        },
        "security": [
          {
            "jwt": []
          }
        ]
      }
    },
    "/promotions/promotions": {
      "get": {
        "summary": "Lista todas as promoções ativas",
        "description": "Retorna uma lista de todas as promoções e descontos atualmente ativos",
        "operationId": "getPromotions",
        "tags": [
          "Promotions"
        ],
        "responses": {
          "200": {
            "description": "Lista de promoções retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Promotion"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Product": {
        "type": "object",
        "description": "Representa um produto no catálogo",
        "required": [
          "id",
          "name",
          "price"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "ID único do produto",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "Nome do produto",
            "example": "Laptop"
          },
          "price": {
            "type": "number",
            "format": "float",
            "description": "Preço do produto",
            "example": 1200.00
          }
        }
      },
      "ProductInput": {
        "type": "object",
        "description": "Dados de entrada para criar ou atualizar um produto",
        "required": [
          "name",
          "price"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome do produto",
            "example": "Teclado Mecânico"
          },
          "price": {
            "type": "number",
            "format": "float",
            "description": "Preço do produto",
            "example": 150.00
          }
        }
      },
      "Order": {
        "type": "object",
        "description": "Representa um pedido no sistema",
        "required": [
          "id",
          "product_id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "ID único do pedido",
            "example": 101
          },
          "product_id": {
            "type": "integer",
            "format": "int64",
            "description": "ID do produto associado ao pedido",
            "example": 1
          },
          "status": {
            "type": "string",
            "description": "Status do pedido",
            "enum": [
              "pending",
              "processing",
              "shipped",
              "delivered",
              "cancelled"
            ],
            "example": "pending"
          }
        }
      },
      "OrderInput": {
        "type": "object",
        "description": "Dados de entrada para criar um novo pedido",
        "required": [
          "product_id"
        ],
        "properties": {
          "product_id": {
            "type": "integer",
            "format": "int64",
            "description": "ID do produto para o novo pedido",
            "example": 1
          }
        }
      },
      "PaymentInput": {
        "type": "object",
        "description": "Dados de entrada para processar um pagamento",
        "required": [
          "amount",
          "card_token"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "format": "float",
            "description": "Valor do pagamento em reais",
            "example": 199.99
          },
          "card_token": {
            "type": "string",
            "description": "Token do cartão de crédito (tokenizado para segurança)",
            "example": "tok_abcdef123456"
          }
        }
      },
      "PaymentResult": {
        "type": "object",
        "description": "Resultado do processamento de pagamento",
        "required": [
          "status",
          "transaction_id",
          "amount"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Status do pagamento",
            "enum": [
              "processed",
              "pending",
              "failed",
              "declined"
            ],
            "example": "processed"
          },
          "transaction_id": {
            "type": "string",
            "description": "ID único da transação",
            "example": "txn_656e5f3f0d8a9"
          },
          "amount": {
            "type": "number",
            "format": "float",
            "description": "Valor processado",
            "example": 199.99
          }
        }
      },
      "Promotion": {
        "type": "object",
        "description": "Representa uma promoção ativa no sistema",
        "required": [
          "id",
          "name",
          "discount"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "ID único da promoção",
            "example": 10
          },
          "name": {
            "type": "string",
            "description": "Nome da promoção",
            "example": "Black Friday"
          },
          "discount": {
            "type": "string",
            "description": "Percentual ou valor de desconto",
            "example": "20%"
          }
        }
      },
      "Error": {
        "type": "object",
        "description": "Resposta de erro padrão",
        "properties": {
          "code": {
            "type": "integer",
            "description": "Código de erro HTTP"
          },
          "message": {
            "type": "string",
            "description": "Mensagem de erro"
          }
        }
      }
    },
    "securitySchemes": {
      "jwt": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT para autenticação. Formato: Bearer <token>"
      }
    }
  },
  "tags": [
    {
      "name": "Catalog",
      "description": "Operações relacionadas ao catálogo de produtos"
    },
    {
      "name": "Orders",
      "description": "Operações relacionadas a pedidos"
    },
    {
      "name": "Payment",
      "description": "Operações relacionadas a processamento de pagamentos"
    },
    {
      "name": "Promotions",
      "description": "Operações relacionadas a promoções e descontos"
    }
  ]
}
